# Copy to `.env.local` and fill in. Never commit real values.
# `.env*` is git-ignored. Server-only values must never be prefixed NEXT_PUBLIC_.

# --- Supabase (REQUIRED: enquiry persistence + /api/health) -------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase auth keys (RECOMMENDED) ----------------------------------------
# Public/publishable key used for ordinary sign up / sign in / refresh.
# Falls back to the service-role key if unset, which is not recommended.
SUPABASE_ANON_KEY=
# Public alias, used only if SUPABASE_ANON_KEY is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin allowlist (REQUIRED for admin access) -----------------------------
# Comma-separated, server-only. Empty means nobody is an admin.
ADMIN_EMAILS=team@unflect.in

# --- Email delivery (OPTIONAL; enquiries are saved even if email fails) ------
EMAIL_FROM=UNFLECT <notifications@unflect.in>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
STUDIO_NOTIFICATION_EMAIL=team@unflect.in

# --- Shared rate-limit store (OPTIONAL) --------------------------------------
# Upstash Redis (REST). Without it, an in-process limiter is used, which is
# NOT shared across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Rate-limit IP source (OPTIONAL) ----------------------------------------
# Behind a proxy, set this to the header carrying the real client IP
# (e.g. "cf-connecting-ip"). Only that header is trusted, so a spoofed
# x-forwarded-for cannot rotate the rate-limit key.
CLIENT_IP_HEADER=

# --- Analytics / verification (OPTIONAL) -------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
